; ======== programs/inex1-preincarcator.mec ========
; Preîncărcătorul programului INEX-1 — MECIPT-1
; Transcris din: V. Baltac, „MECIPT – Evocări și Documente” (2011), Facsimil 5,
;               „INSTRUCȚIUNI LA PROGRAMUL INEX-1 — Se introduce manual”.
; Procedura originală: „după care se pune banda INEX-1 în cititor de la primul
; caracter perforat și se pornește calculatorul de la 0010.”
; Alte puncte de intrare INEX-1 (din același facsimil, codul lor nu s-a păstrat):
;   citirea benzilor de la pupitru 0040 (sau 0026); ca program 0025 (revine la V);
;   tipăriri: format 0133, numere întregi 0134, numere subunitare 0135 (146 VF),
;   trece peste n rânduri 0132, trece peste n spații 0136, tipărește de la A la B 0246.
;
; Format: AAAA  c1 a1  c2 a2   (octal, ca în facsimil)

@prov ORIGINAL Facsimil 5, Baltac
0000  00 0000  00 0000
; Ultima cifră a cuvântului 0001 e corectată de mână în facsimil; citită „0”.
; Doar cu 0000 instrucțiunea MS 0014 mărește corect adresa lui ME la fiecare cuvânt.
@prov DEDUS Facsimil 5, Baltac; cifra corectată de mână citită 0
0001  00 0001  00 0000

@prov ORIGINAL Facsimil 5, Baltac

0010  27 0000  02 0001
0011  21 0005  33 0044
0012  05 0044  16 0011
0013  15 0014  00 0000
0014  25 0002  01 0001
0015  14 0014  15 0010

; ======== programs/src/inex1-rutine.mec ========
; Rutinele INEX-1 — RECONSTRUCȚIE (Planul 6), MECIPT-1
; Din Facsimilul 5 (V. Baltac, „MECIPT – Evocări și Documente”, 2011) se știu doar preîncărcătorul și
; punctele de intrare: citirea benzilor de la pupitru 0040 (sau 0026), ca program 0025 (revine la V);
; tipăriri: format 0133, numere întregi 0134, numere subunitare 0135 (146 VF), trece peste n rânduri 0132,
; trece peste n spații 0136, tipărește de la A la B 0246. Codul de mai jos e scris acum, după aceste puncte.
;
; Convenția de chemare (GHICIT, docs/semantica.md):
;   - programul pune în V (0002) cuvântul „T r  CU”, unde r e locul unde continuă; argumentul în S; sare la intrare;
;   - rutina se termină cu T 0002; strică S, I și celulele de lucru 0003–0007 (0044 e celula cititorului).
;   - 0133: S = c1 α c2 β (α cifre pentru întregi, β zecimale pentru subunitare); după încărcare α = 3, β = 9.
;   - 0134: S = n·2⁻³⁰; „-” dacă n < 0, apoi α cifre, zerourile din față ca spații.
;   - 0135: „-” dacă S < 0, apoi „o,” și β zecimale (trunchiate), apoi semnul de după număr „-” (Facsimilul 3).
;   - 0136 / 0132: S = −n·2⁻⁵; n spații / n rânduri noi.
;   - 0246: S = 00 A 00 B; cuvintele de la A la B cu 0135, câte 5 pe rând.
;   - 0040 (0026): de la pupitru, citește cuvinte de pe bandă (6 rânduri pe cuvânt) la adresa din ME-ul de la 0045,
;     până la sfârșitul benzii; 0025: S = 00 A 00 n, citește n cuvinte la A, revine prin V.
; Pe bandă intră doar m1–m30: nicio constantă de aici nu are semn. Codurile de caractere ≥ 8 au bitul m0,
; de aceea se țin deplasate cu un bit (cod·2⁻⁴ … ) și se refac cu DS 1 înainte de AC 0136.
; Cuvântul 0001 (constanta 1·2⁻³⁰) și 0000 (zero) sunt ale preîncărcătorului și se folosesc și aici.

@prov RECONSTRUCTIE INEX-1 reconstruit (Planul 6), după punctele de intrare din Facsimil 5
0002  O 0002  CU 0000   ; V: celula de revenire (programul pune aici T r)
0003 = o00000000000   ; celule de lucru
0004 = o00000000000
0005 = o00000000000
0006 = o00000000000
0007 = o00000000000
@prov GHICIT INEX-1 reconstruit: formatul implicit (α = 3, β = 9 ca în Facsimil 3)
0016 = o00000000003   ; α: cifrele numerelor întregi
0017 = o00000000011   ; β: zecimalele numerelor subunitare
0020 = o00000001750   ; 10^α
@prov RECONSTRUCTIE INEX-1 reconstruit (Planul 6), după punctele de intrare din Facsimil 5
0021 = 0,625   ; 10/16: înmulțirea cu 10 a fracției, cifra în s0…s3 după DLS 1
0022 = o00777777777   ; șterge s0…s3 (cifra tipărită)
0023 = o00200000000   ; 2⁻⁵: pasul contorului de spații / rânduri
0024 = o00000001777   ; câmpul adresei 1
0025  T 0203  CU 0000   ; 0025: citirea unei benzi „ca program”, revine la V
0026  T 0040  CU 0000   ; 0026: citirea benzilor de la pupitru (aceeași cu 0040)
0027 = o05000000000   ; spațiu (codul 10, deplasat)
0030 = o05400000000   ; virgulă
0031 = o06000000000   ; minus — și semnul de după număr
0032 = o06400000000   ; rând nou
0033 = o00000000005
0034  U 0000  T 0135   ; model pentru „U A, T 0135” (0246)
0035  T 0262  CU 0000   ; revenirea în 0246 după 0135
0036  ME 0000  U 0001   ; model pentru „ME A, U 0001” (0025)
0037 = o00000000000   ; 0246: argumentul
; ---- 0040: citirea benzilor de la pupitru (ca preîncărcătorul: santinela −1, câte 5 biți pe rând) ----
0040  UI 0000  UN 0001   ; I ← 0; S ← −1 (santinela)
0041  DLS 0005  CIT 0044   ; încă un rând
0042  A 0044  TPO 0041   ; cât S < 0 (santinela n-a ajuns la semn)
0043  T 0045  CU 0000
0044 = o00000000000   ; 0044: rândul citit (celula cititorului, folosită și de preîncărcător)
0045  ME 0400  U 0001   ; memorează cuvântul (adresa se schimbă de la pupitru); S ← 1
0046  MS 0045  T 0040   ; adresa + 1; următorul cuvânt
0047 = o00000000000   ; 0246: adresa curentă
0050 = o00000000000   ; 0246: −(cuvinte rămase)
0051 = o00000000000   ; 0246: V-ul chemătorului
0052 = o00000000000   ; 0246: −(locuri rămase pe rând)
; ---- 0135: număr subunitar ----
