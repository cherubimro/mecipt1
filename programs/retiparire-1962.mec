; Constantele citite de program din afara listingului — nu s-au păstrat.
@prov RECONSTRUCTIE dedus din logica programului (Facsimil 4); glifele 10 = spațiu, 13 = rând nou sunt GHICITE
; 1551: locul unde se păstrează cuvântul tipărit (scris de program)
1551 = o00000000000
; 1556: caracterul „spațiu” în s0…s3 (cod 10 = 1010)
1556 = o12000000000
; 1557: caracterul „rând nou” în s0…s3 (cod 13 = 1101)
1557 = o15000000000
; 1600: masca ce golește adresa 1 (m21–m30) a instrucțiunii de la 1512
1600 = o17777776000
; 1675: unitatea de adresă (1 în adresa 1)
1675 = o00000000001
@prov RECONSTRUCTIE parametri de rulare: tipărește chiar acest program (1477–1545 = 39 de cuvinte)
; 1625: contorul = numărul de cuvinte − 1
1625 = o00000000046
; 1626: adresa primului cuvânt de tipărit
1626 = o00000001477
